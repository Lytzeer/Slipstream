{
  "expo": {
    "name": "Slipstream",
    "slug": "slipstream",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/01-app-icon-1024x1024.png",
    "scheme": "slipstream",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.slipstreamapp.slipstream",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111828",
        "foregroundImage": "./assets/images/01-app-icon-1024x1024.png",
        "backgroundImage": "./assets/images/01-app-icon-1024x1024.png",
        "monochromeImage": "./assets/images/01-app-icon-1024x1024.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/01-app-icon-1024x1024.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-router",
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/01-app-icon-1024x1024.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#111828"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "59052126-e373-468f-8c96-661e6dde0d55"
      }
    },
    "owner": "slipstream-app"
  }
}
